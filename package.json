{
  "name": "atomburn",
  "version": "0.16.7",
  "private": true,
  "description": "Community Windows laser workflow for ATOMSTACK X30 Pro via Mintion LaserCam V2 or diagnostic USB.",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "apps",
    "packages",
    "output/pdf/ATOMburn-camera-calibration-target-4x11.pdf",
    "output/pdf/ATOMburn-camera-bed-alignment-target-400x400-tiled.pdf",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "electron-vite build && node scripts/generate-icons.mjs",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 4173",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "preview": "pnpm ensure:electron && electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:stability": "vitest run tests/sprint13",
    "test:reporter-contract": "node scripts/check-failure-report.mjs",
    "test:package-boundary": "node scripts/check-package-boundary.mjs",
    "test:links": "node scripts/check-markdown-links.mjs",
    "test:electron": "pnpm ensure:electron && node scripts/electron-smoke.mjs",
    "test:electron-serial": "pnpm ensure:electron && electron scripts/electron-serial-smoke.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:hardware:visual": "node scripts/hardware-visual-acceptance.mjs",
    "gate:a": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:reporter-contract && pnpm test:package-boundary && pnpm test:links && pnpm build && pnpm test:electron-serial && pnpm test:electron && pnpm test:e2e",
    "build:id": "node scripts/build-id.mjs",
    "upstream:status": "node scripts/upstream-status.mjs",
    "release:manifest": "node scripts/release-artifacts.mjs manifest",
    "release:portable-manifest": "node scripts/portable-manifest.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "release:invariants": "node scripts/release-artifacts.mjs invariants",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fast-check": "4.3.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@deluksic/opencv-calibration-wasm": "0.2.5",
    "dxf-parser": "1.1.2",
    "fast-xml-parser": "5.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serialport": "13.0.0",
    "sharp": "0.35.3",
    "svg-path-parser": "1.1.0",
    "zod": "4.1.12"
  }
}
